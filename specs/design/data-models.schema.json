{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform-scaffold/specs/design/data-models.schema.json",
  "title": "platform-scaffold data models",
  "description": "JSON Schema (draft-07) for every entity in data-models.md. Field names are the SQL (snake_case) column names. Faithful to SPEC.md v1 §8.1, §11, §12, §18, §19.",
  "type": "object",
  "definitions": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "email", "email_verified", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email" },
        "email_verified": { "type": "boolean" },
        "image": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user_id", "token", "expires_at", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "user_id": { "$ref": "#/definitions/uuid" },
        "token": { "type": "string" },
        "expires_at": { "$ref": "#/definitions/timestamp" },
        "ip_address": { "type": ["string", "null"] },
        "user_agent": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user_id", "account_id", "provider_id", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "user_id": { "$ref": "#/definitions/uuid" },
        "account_id": { "type": "string" },
        "provider_id": { "type": "string", "enum": ["credential", "google"] },
        "access_token": { "type": ["string", "null"] },
        "refresh_token": { "type": ["string", "null"] },
        "id_token": { "type": ["string", "null"] },
        "access_token_expires_at": { "type": ["string", "null"], "format": "date-time" },
        "scope": { "type": ["string", "null"] },
        "password": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identifier", "value", "expires_at", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "identifier": { "type": "string" },
        "value": { "type": "string" },
        "expires_at": { "$ref": "#/definitions/timestamp" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug", "type", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "type": "string", "enum": ["personal", "team"] },
        "logo": { "type": ["string", "null"] },
        "metadata": { "type": ["object", "null"] },
        "deleted_at": { "type": ["string", "null"], "format": "date-time" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization_id", "user_id", "role", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "organization_id": { "$ref": "#/definitions/uuid" },
        "user_id": { "$ref": "#/definitions/uuid" },
        "role": { "type": "string" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "invitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization_id", "email", "role", "status", "expires_at", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "organization_id": { "$ref": "#/definitions/uuid" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "inviter_id": { "type": ["string", "null"], "format": "uuid" },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked", "expired"] },
        "expires_at": { "$ref": "#/definitions/timestamp" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "entitlement_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "org_id", "key", "value", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "org_id": { "$ref": "#/definitions/uuid" },
        "key": { "type": "string" },
        "value": { "type": ["number", "boolean"] },
        "updated_by": { "type": ["string", "null"], "format": "uuid" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "audit_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "target_type", "created_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "org_id": { "type": ["string", "null"], "format": "uuid" },
        "actor_user_id": { "type": ["string", "null"], "format": "uuid" },
        "action": { "type": "string" },
        "target_type": { "type": "string" },
        "target_id": { "type": ["string", "null"] },
        "metadata": { "type": ["object", "null"] },
        "ip": { "type": ["string", "null"] },
        "user_agent": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "org_id", "name", "created_by", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "org_id": { "$ref": "#/definitions/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "created_by": { "$ref": "#/definitions/uuid" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "org_id", "workspace_id", "title", "status", "created_by", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "org_id": { "$ref": "#/definitions/uuid" },
        "workspace_id": { "$ref": "#/definitions/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "type": "string", "enum": ["open", "done"] },
        "assignee_member_id": { "type": ["string", "null"], "format": "uuid" },
        "due_date": { "type": ["string", "null"], "format": "date" },
        "created_by": { "$ref": "#/definitions/uuid" },
        "created_at": { "$ref": "#/definitions/timestamp" },
        "updated_at": { "$ref": "#/definitions/timestamp" }
      }
    }
  },
  "properties": {
    "user": { "$ref": "#/definitions/user" },
    "session": { "$ref": "#/definitions/session" },
    "account": { "$ref": "#/definitions/account" },
    "verification": { "$ref": "#/definitions/verification" },
    "organization": { "$ref": "#/definitions/organization" },
    "member": { "$ref": "#/definitions/member" },
    "invitation": { "$ref": "#/definitions/invitation" },
    "entitlement_override": { "$ref": "#/definitions/entitlement_override" },
    "audit_log": { "$ref": "#/definitions/audit_log" },
    "workspace": { "$ref": "#/definitions/workspace" },
    "task": { "$ref": "#/definitions/task" }
  }
}
