# Copy to .env and fill in real values. Never commit .env.
# Values below are placeholders documenting required configuration only.

# Node runtime environment: development | test | production
NODE_ENV=development

# Public base URL the app is served from.
APP_URL=http://localhost:3000

# PostgreSQL connection string used by the API and drizzle-kit.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform

# Secret used to sign auth sessions (generate a long random value per environment).
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth web-client credentials. Configure the authorized redirect URI as
# http://localhost:3000/api/auth/callback/google for local Docker development.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# SMTP transport for outbound email (dev uses Mailpit on 1025).
SMTP_URL=smtp://localhost:1025

# Optional production override for the app_runtime database-role password.
# APP_RUNTIME_PASSWORD=replace-with-a-strong-random-password
