{
  "name": "platform-scaffold",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:isolation": "vitest run --config vitest.isolation.config.ts",
    "ops": "tsx ops/src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/platform-db/src/migrate.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@platform/config": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@platform/db": "workspace:*",
    "@platform/identity": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
